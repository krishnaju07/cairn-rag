# Optional. The app runs fully offline with local embeddings and no keys.
# You can also paste keys on the Providers page instead of editing this file.

# Where the database, uploads and downloaded models live.
# DATA_DIR=./data

# Extra host names the app may be served under (comma separated). Local hosts are always allowed.
# ALLOWED_HOSTS=

# Local answers through Ollama (free). Install it, then run: ollama pull qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# Free hosted answers from NVIDIA (build.nvidia.com). Your question and passages are sent to NVIDIA.
NVIDIA_API_KEY=

# Paid answers through the Anthropic API.
ANTHROPIC_API_KEY=

# Paid OCR and layout parsing through LlamaCloud.
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_PROJECT_ID=

# Upload and worker limits.
MAX_UPLOAD_MB=50
INGEST_WORKERS=2
